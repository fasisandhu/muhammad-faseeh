# ---------------------------------------------------------------------------
# Keycloak (docker compose)
# ---------------------------------------------------------------------------
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin
# Optional: create a GitHub OAuth App with callback
# http://localhost:8080/realms/ggi/broker/github/endpoint and paste its credentials here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# PostgreSQL and Redis (docker compose)
# ---------------------------------------------------------------------------
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis
# Host ports published by compose (change if 5432/6379 are already taken locally):
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
# Used by `pnpm db:migrate` when running outside docker:
DATABASE_MIGRATION_URL=postgres://ggi_owner:change-me-owner@localhost:5432/ggi

# ---------------------------------------------------------------------------
# API (docker compose passes these to the api container)
# ---------------------------------------------------------------------------
HEALTH_CHECK_TOKEN=change-me-to-a-random-token-of-32-or-more-chars
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
PAYMENT_FAILURE_RATE=0.2

# ---------------------------------------------------------------------------
# Only for `pnpm dev` outside docker (compose builds these URLs itself).
# Keep the passwords in sync with the values above. The host ports in
# DATABASE_URL, DATABASE_MIGRATION_URL and REDIS_URL must match POSTGRES_HOST_PORT
# and REDIS_HOST_PORT above.
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://ggi_app:change-me-app@localhost:5432/ggi
REDIS_URL=redis://:change-me-redis@localhost:6379
OIDC_ISSUER=http://localhost:8080/realms/ggi
OIDC_JWKS_URI=http://localhost:8080/realms/ggi/protocol/openid-connect/certs